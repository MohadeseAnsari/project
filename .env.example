# Postgres credentials. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# There is deliberately NO default: compose fails to start if this is unset,
# because a `:-postgres` fallback silently exposed the database with a
# guessable password. Never publish 5432 on a public interface.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=irandoc_news
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/irandoc_news
SHARED_SECRET=change-me-in-production
AVALAI_API_KEY=your-avalai-api-key
AVALAI_BASE_URL=https://api.avalai.ir/v1
LLM_MODEL=gpt-5.6-luna
# LLM call timeout (seconds) and output token cap. Raise the timeout for
# long theses; the cap keeps generation bounded.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=1000
# Combined generation + ISCED-F 2013 classification (ONE LLM call per thesis,
# v2-combined). Keep AT MOST this many category matches per record.
TOP_N_CATEGORIES=3
# A stored match only routes the article at or above this relevance score.
MIN_CATEGORY_RELEVANCE=0.5
# When true, articles with at least one qualifying match skip the human gate
# (deliveries queue as pending). A record classified only as `other` NEVER
# auto-publishes, even when this is true — it waits for a reviewer.
# Compact LLM output (v3-compact): reasons are optional for high-confidence
# matches. Set to 101 to always require a reason (stricter audit).
SKIP_REASON_ABOVE_SCORE=90
# If true, store the FULL raw LLM response JSON in main.llm_raw_output
# (debugging aid, ~200 bytes/record). Default off.
STORE_LLM_RAW_OUTPUT=false
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_LEASE_MINUTES=5
# Read by the `sender` AND by the `web` (panel) service. The panel needs a
# token to validate a new channel target and to delete a published message
# from a channel that has no per-channel token of its own.
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
SENDER_SEND_DELAY_SECONDS=5
SENDER_POLL_INTERVAL_SECONDS=2
SENDER_MAX_ATTEMPTS=5
SENDER_BACKOFF_BASE_SECONDS=10
SENDER_REQUEST_TIMEOUT_SECONDS=20
SENDER_LEASE_MINUTES=5
# Human approval gate for publishing.
# - true: deliveries start as awaiting_confirmation; a reviewer must approve.
# - false: news is auto-published to the matched categories' channels.
#          Use only after channel routing has been verified
#          (see scripts/auto_route_channels.py).
REQUIRE_HUMAN_CONFIRMATION=false
# What to do when an article has NO qualifying category match:
# review (default, safest) | fallback_other | failed
UNMATCHED_CATEGORY_BEHAVIOR=review
# Review panel admin (created at runtime if missing; password from env only).
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
PANEL_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Published panel port. Loopback-only (SSH tunnel or local reverse proxy);
# set `8081` to bind all interfaces (public, only behind a TLS proxy).
PANEL_PORT=127.0.0.1:8081
# Send the session cookie with Secure only behind a TLS reverse proxy
# (browsers drop Secure cookies over plain HTTP).
PANEL_COOKIE_SECURE=false
# Login guardrails: failures per IP inside the window trigger a lockout.
PANEL_LOGIN_MAX_ATTEMPTS=10
PANEL_LOGIN_WINDOW_MINUTES=10
PANEL_LOGIN_LOCKOUT_MINUTES=15
# Session lifetime in hours (cookie and server-side check agree).
PANEL_SESSION_HOURS=12
# Extra trusted proxy peers for X-Forwarded-* (the host proxy reaches the app
# as the bridge gateway, not loopback). Discover with:
#   docker network inspect project_default --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
PANEL_TRUSTED_PROXIES=
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins allowed to call the API cross-origin. The demo
# UI on :8080 needs this. Add the host you will present from, e.g.
# "http://example.com:8080". Not "*": the API is authenticated with a secret.
DEMO_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
